DATABASE_URL=postgres://planejai:planejai@db:5432/planejai?sslmode=disable

# Chave mestra para criptografar (AES-256-GCM) o token de IA de cada professor
# em repouso. Precisa ser base64 de 32 bytes aleatórios, ex.: `openssl rand -base64 32`.
# Obrigatória: sem ela, salvar um token falha e a geração com IA fica indisponível.
TOKEN_ENC_KEY=

SESSION_SECRET=change-me-32-bytes-min
PORT=8080
# Origem do backend usada pelo proxy /api do Next (server-side, nunca vai ao
# browser). Em produção, aponte para o domínio privado do serviço da API.
API_ORIGIN=http://localhost:8080

# Marque como true quando o site for servido por HTTPS: adiciona a flag Secure
# aos cookies de sessão. Deixe vazio em desenvolvimento local (HTTP).
COOKIE_SECURE=

# Só necessário se o frontend chamar a API em outra origem, sem o proxy do Next.
# Vazio = nenhum header CORS é enviado.
CORS_ORIGIN=
